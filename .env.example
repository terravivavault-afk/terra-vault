# Copy to .env for local builds, or add these as Environment Variables in Vercel
# (Project -> Settings -> Environment Variables) and as Variables in GitHub
# (Repo -> Settings -> Secrets and variables -> Actions -> Variables).
# ONLY public values go here. Never put the Supabase service_role key in this project.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://nfrrkbxlndzufqierwqd.supabase.co
SUPABASE_ANON_KEY=<publishable / anon key>

# Public address of the deployed site, no trailing slash.
# Must also be listed in Supabase -> Authentication -> URL Configuration.
SITE_URL=https://terra-vault.vercel.app

# Cloudinary -> Settings -> Upload -> Upload presets (mode: Unsigned). Public values only;
# never add the Cloudinary API secret here.
CLOUDINARY_CLOUD_NAME=jnwhkmj0
CLOUDINARY_UPLOAD_PRESET=terravault_unsigned
